rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Settings - public read, admin write
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    
    // News - public read, admin write
    match /news/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    
    // Directions - public read, admin write
    match /directions/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    
    // Facilities - public read, admin write
    match /facilities/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    
    // Gallery - public read, admin write
    match /gallery/{document} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid != null;
    }
    
    // Applications - public create only, admin read/write
    match /applications/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.uid != null;
    }

    // Public forms - anyone may submit, only authenticated admins may read.
    match /admissions/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.uid != null;
    }

    match /contactMessages/{document} {
      allow create: if true;
      allow read, update, delete: if request.auth != null && request.auth.uid != null;
    }
  }
}